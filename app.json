{
  "expo": {
    "name": "القراَن الكريم",
    "slug": "quran-kareem-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/quran-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/quran-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.kareemabuayyash.qurankareemapp"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "experiments": {
      "baseUrl": "/QuranApp"
    },
    "extra": {
      "eas": {
        "projectId": "ec0f3f93-8401-4883-99b9-cc92aba6537f"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم التطبيق موقعك لتحديد اتجاه القبلة بدقة."
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
